# ==========================================================
# Zugangsdaten / Secrets – niemals versionieren
# ==========================================================
*.env
.env.*
secrets/
*.pem
*.key

# ==========================================================
# VS Code – nur unbedenkliche, geteilte Konfiguration tracken
# (sftp.json enthält Host/Nutzername unseres Hostings -> ignoriert;
#  sftp.json.example bleibt als Vorlage versioniert)
# ==========================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/sftp.json.example

# ==========================================================
# Windows (offizielles GitHub-Template: github/gitignore Global/Windows.gitignore)
# ==========================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ==========================================================
# macOS (falls auch von einem Mac aus gearbeitet wird)
# ==========================================================
.DS_Store

# ==========================================================
# Node / Build-Tools (noch ungenutzt, aber falls das Prototyp-Setup
# später z. B. zu Astro/11ty wird)
# ==========================================================
node_modules/
dist/
.cache/
npm-debug.log*

# ==========================================================
# Ad-hoc Screenshots im Root (z. B. per Chat/IDE-Paste, kein echtes Asset)
# Echte Bilder gehören nach prototype/assets/img/ o.ä. und sind davon nicht betroffen.
# ==========================================================
/image.png
/image (*).png
/Screenshot*.png

# ==========================================================
# Interne Projekt-/Kontextdateien – bewusst nicht Teil des Repos, das
# ggf. öffentlich für GitHub Pages genutzt wird. Bleiben lokal auf der
# Maschine erhalten (Claude Code liest CLAUDE.md weiterhin lokal),
# werden aber nicht mehr versioniert/gepusht. CHANGELOG.md bleibt bewusst
# ausgenommen (Projektverlauf soll nachvollziehbar bleiben).
# ==========================================================
/CLAUDE.md
/docs/

# ==========================================================
# Rohe Original-Bild-/Flyer-Ordner von Ellen – reines Quellmaterial
# (Original-Fotos, Original-Flyer inkl. PDFs). Die für die Website
# tatsächlich genutzten, bearbeiteten Versionen liegen als eigene
# Kopien in prototype/assets/img/ und sind davon nicht betroffen.
# Ordner-Regel gilt bewusst pauschal, damit auch künftig dort
# abgelegte Originale/private Rohdateien automatisch draußen bleiben.
# ==========================================================
/Homepage Ellen - Farbdatei und Foto/
/Homepage Ellen - Flyer dateien/
/Instagram - Impressi - Konzept.docx

# ==========================================================
# Roh-Zusendungen von Ellen (E-Mail-Anhänge etc.) – verarbeitete Ergebnisse
# liegen jeweils in prototype/assets/img/, die Rohdateien bleiben nur lokal.
# ==========================================================
/Ellens Website - Event seite.zip
/IMG-20260831-WA0068.jpg

# ==========================================================
# Logs / temporäre Dateien
# ==========================================================
*.log
*.tmp
*.bak
